    {
      "name": "4. Search and Sorting",
      "item": [
        {
          "name": "Search Carrels By Zone A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned carrels belong to Zone A\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "    jsonData.data.forEach(function (c) {",
                  "        pm.expect(c.zone.toUpperCase()).to.eql(\"A\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carrels?zone=A",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carrels"
              ],
              "query": [
                {
                  "key": "zone",
                  "value": "A"
                }
              ]
            },
            "description": "Searches and filters carrels located in Zone A."
          }
        },
        {
          "name": "Sort Carrels Ascending (A to Z)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Carrels are in alphabetical order A-Z\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    var names = jsonData.data.map(function(c) { return c.name; });",
                  "    var sorted = [...names].sort();",
                  "    pm.expect(names).to.eql(sorted);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
